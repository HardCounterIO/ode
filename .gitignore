*.exe
*.dll
*.sys
*.scr
*.msi
*.bin
*.so
*.dylib
*.apk
*.jar

# NOT ignored on purpose: dataset formats (.evtx, .pcap, .json, .csv,
# .parquet) and logos/images under assets/.
